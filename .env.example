# Salin menjadi .env.local (JANGAN di-commit). Di Vercel isi lewat Project Settings > Environment Variables.

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Supabase ----
# URL + anon/publishable key boleh publik (dipakai browser untuk login magic link).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret/service key: HANYA server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=

# ---- Google Apps Script ----
GAS_WEB_APP_URL=
# Harus sama persis dengan Script Property SHARED_SECRET di Apps Script. Min 32 karakter acak.
# Buat nilai acak: npm run gen-secrets
GAS_SHARED_SECRET=

# ---- Meta WhatsApp Cloud API ----
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
# Min 24 karakter acak (npm run gen-secrets); samakan di dashboard Meta.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# ---- Tampilan onboarding (aman publik) ----
NEXT_PUBLIC_BOT_EMAIL=aura-bot@gmail.com
NEXT_PUBLIC_BOT_WA_NUMBER=628xxxxxxxxxx
# Link template Sheets, akhiri dengan /copy agar langsung muncul dialog "Buat salinan"
NEXT_PUBLIC_TEMPLATE_URL=https://docs.google.com/spreadsheets/d/ID_TEMPLATE/copy

# ---- Admin & URL situs ----
# Email yang boleh membuka /admin (pisahkan dengan koma). Wajib login dengan email ini.
ADMIN_EMAILS=
# URL publik situs (tanpa / di akhir), mis. https://aura.vercel.app. Kosong = pakai alamat browser.
NEXT_PUBLIC_SITE_URL=
